#!/usr/bin/env bash


# 
# note: when the boot script runs NOTHING is setup
#       this script:
#       1. sets up all the normal user stuff
#       2. logs all output to $HOME/boot.log
#       3. runs cv_dark/commands/xavier/boot_control/boot_command.ignore IN A LOOP
# 

username="xavier"
home="/home/$username"
boot_log="$home/boot.log"
old_boot_log="$home/boot.old.log"

# handle logging file
rm -f "$old_boot_log"
# copy old file
if [ -f "$boot_log" ]
then
    cp "$boot_log" "$old_boot_log"
fi
rm -f "$boot_log"


sudo runuser - "$username" -c '
    while true
    do
        . /home/xavier/.zshrc
        cd /home/xavier/repos/cv_dark/
        . "/home/xavier/repos/cv_dark/commands/xavier/boot_control/boot_command.ignore"
        
        echo "#"
        echo "#"
        echo "#"
        echo "# PROCESS DIED RESTARTING"
        echo "#"
        echo "#"
        echo "#"
    done
'  2>>"$boot_log" 1>>"$boot_log"