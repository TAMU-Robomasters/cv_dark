#!/usr/bin/env bash
read -r -d '' stuff_for_sudo <<'HEREDOC_NAME'

echo '[Unit]
Description=CV Dark Boot
After=network.target

[Service]
ExecStart=sudo /home/xavier/repos/cv_dark/commands/xavier/boot_control/cv_dark_infinite_run

[Install]
WantedBy=default.target
' > /etc/systemd/system/cv_dark_boot.service

echo "#"
echo "# starting services"
echo "#"
sudo systemctl enable cv_dark_boot
sudo systemctl start cv_dark_boot

HEREDOC_NAME

echo "#"
echo "# writing to /etc/systemd/system/xavier_boot.service"
echo "#"
sudo bash -c "$stuff_for_sudo"

echo "#"
echo "# ensuring executable"
echo "#"
filepath="/home/xavier/repos/cv_dark/commands/xavier/boot_control/boot_command.ignore"
if ! { [ -f "$filepath" ] && [ -r "$filepath" ] && [ -x "$filepath" ]; }
then
    echo 'NOTE: change this file if this bot uses the ZED camera'
    echo 'file: '"$filepath"
    echo '
        python3 "/home/xavier/repos/cv_dark/main/main.py" @BOARD=XAVIER @GPU=TENSOR_RT @CAMERA=REALSENSE @SHOWTIME
    ' > "$filepath"
    chmod ugo+x "$filepath"
fi
echo "done; restart should now work"